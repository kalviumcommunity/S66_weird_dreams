# MongoDB Connection (Atlas recommended for Render/Cloudflare deploys)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/weird-dreams?retryWrites=true&w=majority

# JWT Secret Key (use a strong random string, min 32 chars)
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

# API Port (Render injects PORT automatically)
PORT=8080

# Gemini API Key (for dream analysis) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# Frontend URL (for CORS + docs)
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
